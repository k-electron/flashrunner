# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
dist/
dist-ssr/
build/
*.local

# Vite / bundler caches
.vite/
node_modules/.vite/
.rollup.cache/
.turbo/
.parcel-cache/

# Test & coverage
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# TypeScript
*.tsbuildinfo

# Lint / format caches
.eslintcache
.stylelintcache
.prettiercache

# Environment variables (never commit secrets)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Deploy platform metadata
.vercel/
.netlify/
.wrangler/

# Editors & IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local agent/tooling state
.claude/settings.local.json
.claude/local/

# Spec Kit catalog fetches. Re-downloaded on demand and time-stamped, so sharing
# them only produces churn. Kept here rather than in .specify/.gitignore, which
# Spec Kit manages and overwrites on upgrade.
.specify/integrations/.cache/
